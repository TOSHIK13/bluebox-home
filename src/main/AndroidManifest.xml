<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- a launcher has to list every installed app; the APK is not distributed through Play -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- card pictures of other apps' Watch Next rows are usually https URLs on their CDN -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Watch Next rows of other apps; granted only to privileged apps, see docs/plans/launcher.md "Риск данных" -->
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />

    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:enableOnBackInvokedCallback="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BlueBoxHome">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:resumeWhilePausing="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- also a normal launcher entry so it can be started and tested without being the default Home -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AllAppsActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".DockEditActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".QuickSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.BlueBoxHome.Panel"
            android:screenOrientation="landscape" />
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <service
            android:name=".data.NotificationFeed"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
